APP_ENV=dev
VENDURE_SERVER_PORT=3000
VENDURE_WORKER_HEALTH_PORT=3020
SUPERADMIN_USERNAME=superadmin
# Replace with your own password (at least 16 characters).
SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
# Must match the root .env used by Docker Compose.
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DB_SCHEMA=public

STOREFRONT_URL=http://localhost:3001
# Required when APP_ENV=production; use the public assets URL.
ASSET_PUBLIC_URL=
EMAIL_FROM="Karpaty Gear <noreply@karpaty-gear.local>"

# Explicit opt-in for demo data creation; keep disabled by default.
ALLOW_DEMO_SEED=false